# Optional — leave unset for status/trend only (public Binance + Kalshi markets).
# Do NOT commit real values. On Render, set these as Environment secrets.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=
# Or mount files:
# KALSHI_PRIVATE_KEY_FILE=
# KALSHI_KEY_DIR=
# DATA_DIR=/opt/render/project/src
# Never set LIVE=1 on the web service itself — Start buttons set it only on the worker.
